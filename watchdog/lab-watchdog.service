[Unit]
Description=Live room watchdog (publishes jason-ss.dev lab status)
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
EnvironmentFile=/etc/lab-watchdog.env
ExecStart=/usr/bin/python3 /opt/lab-watchdog/lab_watchdog.py
Restart=always
RestartSec=15

# Runs as a throwaway user with no write access to the system.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
# ping needs raw sockets; Ubuntu 24.04 disables unprivileged ICMP sockets.
# This is the only privilege the service gets.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
MemoryMax=64M

[Install]
WantedBy=multi-user.target
