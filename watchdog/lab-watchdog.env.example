# Copy to /etc/lab-watchdog.env on the cloud VM and fill in your own values.
# Bucket that holds the public status.json
LAB_BUCKET=your-status-bucket
# Home machines to ping over Tailscale, as name=tailscale-ip pairs
LAB_HOSTS=node1=100.64.0.1,node2=100.64.0.2
# Which of LAB_HOSTS may send OSPF reports
LAB_REPORTER=node1
